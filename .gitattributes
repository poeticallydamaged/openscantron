# Generated artifacts are not source text; keep diffs and whitespace checks clean.
*.pdf binary
*.bmp binary
*.zip binary
*.jar binary
*.png binary
*.jpg binary
*.jpeg binary
*.log -diff

# Source and verification JSON/CSV use LF line endings.
*.kt text eol=lf
*.kts text eol=lf
*.java text eol=lf
*.xml text eol=lf
*.md text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.json text eol=lf
*.csv text eol=lf
*.properties text eol=lf
*.toml text eol=lf
gradlew text eol=lf
